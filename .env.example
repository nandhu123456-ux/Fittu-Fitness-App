# Firebase client config (safe to expose, but keep in env for flexibility)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Cloud Functions env (server-side only — NEVER expose in app)
# Set these with: firebase functions:secrets:set GEMINI_API_KEY
# and: firebase functions:secrets:set OPENAI_API_KEY
GEMINI_API_KEY=
OPENAI_API_KEY=
USDA_API_KEY=